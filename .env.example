# Local development defaults. Populate secrets via your local environment or secret manager.
# In deployed environments provide the same HTTPS origin to the build and runtime.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET=""
# Set true only after configuring a trusted production ingress. Dev does not need it.
AUTH_TRUST_HOST=""
# Optional: only a header that the ingress replaces with one verified client IP.
AUTH_CLIENT_IP_HEADER=""

# Separate runtime and migration roles/URLs. Remote runtime URLs need sslmode=verify-full.
# Example (placeholder only): postgresql://USER:PASSWORD@db.example.invalid/shopbd?sslmode=verify-full
DATABASE_URL=""
# Supply this to the migration job, not to application instances.
DIRECT_URL=""
# Maximum connections per app process; size across all replicas and rolling releases.
DB_POOL_MAX="5"

# Optional as a pair for startup; required for live customer recovery.
RESEND_API_KEY=""
PASSWORD_RESET_FROM=""

# Required for production uploads. The local fallback is development-only.
UPLOADTHING_TOKEN=""
# Optional comma-separated exact HTTPS image hosts (in addition to UploadThing).
MEDIA_IMAGE_HOSTS=""
