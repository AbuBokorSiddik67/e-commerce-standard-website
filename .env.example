# Database (Neon PostgreSQL)
# Pooled connection for app runtime (PgBouncer / Neon pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/PREFIX?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct connection for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/PREFIX?sslmode=require"

# NextAuth / Auth.js v5
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"
# Optional: configure ONLY when trusted ingress replaces this header with one client IP.
AUTH_CLIENT_IP_HEADER=""

# Customer password recovery via Resend. AUTH_URL must be canonical HTTPS in production.
RESEND_API_KEY=""
PASSWORD_RESET_FROM=""

# UploadThing (image uploads)
# Required for uploads in production. Development may use the local fallback.
UPLOADTHING_TOKEN=""

# Additional exact HTTPS image hostnames, comma separated; allowlist built into the optimizer.
MEDIA_IMAGE_HOSTS=""

# App
# Use an HTTPS origin in production (no path/query).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="ShopBD"
NEXT_PUBLIC_CURRENCY_SYMBOL="৳"
